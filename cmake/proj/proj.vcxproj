<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
	<ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
	<ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
	<ProjectGuid>{F276B840-2762-46E5-B36A-4E1CAB34A4F8}</ProjectGuid>
	<Keyword>MakeFileProj</Keyword>
	<RootNamespace>proj</RootNamespace>
	<WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
	<ConfigurationType>Makefile</ConfigurationType>
	<PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
	<CMakeExecutable Condition="'$(CMakeExecutable)'=='' and Exists('$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExecutable>
	<CMakeExecutable Condition="'$(CMakeExecutable)'==''">cmake</CMakeExecutable>
	<TerrainRoot>$(MSBuildProjectDirectory)\..\..</TerrainRoot>
	<IntDir>$(TerrainRoot)\build\out\proj\$(Platform)\</IntDir>
	<OutDir>$(TerrainRoot)\build\$(Platform)\</OutDir>
	<ProjDebugPostfix Condition="'$(Configuration)'=='Debug'">_d</ProjDebugPostfix>
	<NMakeOutput>$(OutDir)proj$(ProjDebugPostfix).lib</NMakeOutput>
	<ProjSqliteOption Condition="'$(ProjSqlite3Executable)'!=''"> -D &quot;EXE_SQLITE3=$(ProjSqlite3Executable)&quot;</ProjSqliteOption>
	<ProjConfigure>&quot;$(CMakeExecutable)&quot; -S &quot;$(MSBuildProjectDirectory)&quot; -B &quot;$(IntDir).&quot; -G &quot;Visual Studio 18 2026&quot; -A $(Platform) -T $(PlatformToolset) -D &quot;THEWORLD_LIB_DIR=$(OutDir).&quot;$(ProjSqliteOption)</ProjConfigure>
	<NMakeBuildCommandLine>$(ProjConfigure) &amp;&amp; &quot;$(CMakeExecutable)&quot; --build &quot;$(IntDir).&quot; --config $(Configuration) --target proj</NMakeBuildCommandLine>
	<NMakeReBuildCommandLine>$(ProjConfigure) &amp;&amp; &quot;$(CMakeExecutable)&quot; --build &quot;$(IntDir).&quot; --config $(Configuration) --target proj --clean-first</NMakeReBuildCommandLine>
	<NMakeCleanCommandLine>if exist &quot;$(IntDir)CMakeCache.txt&quot; &quot;$(CMakeExecutable)&quot; --build &quot;$(IntDir).&quot; --config $(Configuration) --target clean</NMakeCleanCommandLine>
  </PropertyGroup>
  <ItemGroup>
	<None Include="CMakeLists.txt" />
	<None Include="modules\FindSQLite3.cmake" />
	<None Include="..\..\PROJ\CMakeLists.txt"><Link>upstream\CMakeLists.txt</Link></None>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
